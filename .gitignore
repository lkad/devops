# Binaries and executables
devops-toolkit
devops-toolkit.exe
*.exe
*.test
*.out
coverage.html
coverage.txt
bin/
cmd/devops-toolkit/devops-toolkit
# Catch any future Go-binary build artifact in any
# subdirectory (the bare name above only matches the
# repo root; the per-file patterns below catch e.g.
# sub-cmd binaries that might be built ad-hoc). The
# trailing-slash-less form targets files only, NOT
# directories whose name happens to match (a directory
# called `devops-toolkit/` is intentional and should
# stay tracked, e.g. cmd/devops-toolkit/).
*/devops-toolkit
*/devops-toolkit.exe

# Build outputs
cmd/devops-toolkit/devops-toolkit
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo

# Helm chart packages — `helm package` output, the source directories
# under deploy/helm/charts/<name>/ stay tracked. The .tgz is the
# published artifact, regenerated by `helm package` and uploaded to a
# chart repo (OCI registry / chartmuseum / S3) — not committed to git.
deploy/helm/charts/*.tgz

# Test artifacts
tests/fixtures/db/*.db
tests/fixtures/db/*.db-journal
.tmp/
# vitest coverage output (--coverage flag); CI uses Go coverage only,
# the frontend coverage dir is a one-off run output.
frontend/coverage/

# Docker
.docker/
Dockerfile
docker-compose.override.yml
docker-pull.sh

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
/logs/
/scripts/logs/

# Env
.env
.env.local
.env.*.local
# Real prod env file (the .example sibling is committed).
deploy/.env.prod

# Vendored
vendor/

# containerlab runtime artifacts (per-host generated state)
deploy/containerlab/clab-devops-toolkit-clab/
devops-toolkit
.gstack/

# Prober SSH private key. Generate locally with:
#   ssh-keygen -t ed25519 -f deploy/secrets/prober/id_ed25519 -N ""
# The .pub file is intentionally NOT ignored — it can be referenced
# from deploy/containerlab/topology.yml's PUBLIC_KEY for documentation
# and for re-deploying the same key on a different host.
deploy/secrets/prober/id_ed25519
