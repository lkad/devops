# THIS IS AN EXAMPLE. Copy to .env.prod and fill in real values.
# .env.prod is gitignored. NEVER commit the real one.
#
# Variables are grouped by the service that consumes them. The
# devops-toolkit binary reads APP__*, DATABASE__*, LDAP__*, etc.
# (double underscore is the path separator for viper). PostgreSQL,
# Grafana, and LDAP shells read the bare POSTGRES_*, GF_*, and
# LDAP_* forms. Defaults shown in deploy/docker-compose.yml match
# the dev/CI stack; override per-environment here.
#
# Generate strong secrets with: openssl rand -hex 32

# ----- App (devops-toolkit) -----
APP__ENV=production
APP__PORT=3000
# 32-byte (or longer) random hex. Required in production;
# config.Validate refuses to boot if this is empty.
APP__JWT_SECRET=replace-with-32-byte-random-hex
# Optional. Defaults to 3600 (1 hour).
APP__JWT_TTL_SECONDS=3600

# ----- Database -----
# Use sslmode=require in production. The backup script reads
# PGHOST/PGUSER/PGPASSWORD/PGDATABASE individually.
DATABASE__DRIVER=postgres
DATABASE__URL=postgres://replace-with-db-user:replace-with-db-password@postgres:5432/devops?sslmode=require

# ----- PostgreSQL container (read by the postgres:15 image) -----
POSTGRES_DB=devops
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-db-password

# ----- Redis -----
REDIS__HOST=redis
REDIS__PASSWORD=replace-with-redis-password

# ----- LDAP (binary) -----
LDAP__URL=ldaps://ldap:636
LDAP__BIND_DN=cn=service-account,dc=example,dc=com
LDAP__BIND_PASSWORD=replace-with-ldap-bind-password
LDAP__BASE_DN=dc=example,dc=com

# ----- LDAP (bitnami/openldap container) -----
LDAP_ROOT=dc=example,dc=com
LDAP_ADMIN_USERNAME=admin
LDAP_ADMIN_PASSWORD=replace-with-ldap-admin-password

# ----- Logs -----
LOGS__BACKEND=loki
LOGS__LOKI__URL=http://loki:3100
LOG_STORAGE_DIR=/var/lib/devops-toolkit/logs

# ----- Elasticsearch (optional; config-prod.yaml defaults to es) -----
ELASTICSEARCH__URL=https://elasticsearch.internal:9200
ELASTICSEARCH__USERNAME=replace-with-es-username
ELASTICSEARCH__PASSWORD=replace-with-es-password

# ----- InfluxDB v2 (used by the physicalhost metrics sink) -----
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=replace-with-influx-token
INFLUX_ORG=devops-toolkit
INFLUX_BUCKET=metrics

# ----- K8s cluster crypto (AES-256 key for kubeconfig at rest) -----
# 32-byte hex. Required in production.
K8S_CRYPTO_KEY=replace-with-32-byte-random-hex

# ----- mTLS (binary serves HTTPS + client cert verification when
# TLS_CERT_FILE is set). Leave all three blank to keep plain HTTP. -----
TLS_CERT_FILE=/etc/devops-toolkit/tls/cert.pem
TLS_KEY_FILE=/etc/devops-toolkit/tls/key.pem
TLS_CA_FILE=/etc/devops-toolkit/tls/ca.pem

# ----- Physical-host prober -----
# Path inside the container to the SSH key used for SSH prober.
PROBER_SSH_KEY=/etc/devops-toolkit/prober/id_ed25519
PROBER_SSH_TIMEOUT=10s
PROBER_TCP_TIMEOUT=2s
# Set to 1 to force the in-process fake prober (tests + dev only).
PROBER_FAKE=

# ----- OpenTelemetry tracing -----
# Leave OTEL_EXPORTER_OTLP_ENDPOINT blank for stdout-only tracing.
OTEL_EXPORTER=stdout
OTEL_EXPORTER_OTLP_ENDPOINT=

# ----- Grafana -----
GF_SECURITY_ADMIN_PASSWORD=replace-with-grafana-admin-password

# ----- Alertmanager / PagerDuty -----
PAGERDUTY_SERVICE_KEY=
ALERT__SLACK_WEBHOOK=https://hooks.slack.com/services/replace/me
ALERT__SMTP_HOST=smtp.internal
ALERT__EMAIL_TO=oncall@example.com

# ----- Backup script (scripts/backup-postgres.sh) -----
# Leave S3_BUCKET blank to skip the S3 upload step.
S3_BUCKET=
S3_PREFIX=postgres-backups/devops-toolkit
AWS_REGION=us-east-1
# Local backup retention in days (default 7).
BACKUP_RETENTION_DAYS=7
