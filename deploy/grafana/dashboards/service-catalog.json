{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Service catalog operations: how many services we manage, who's on call, how often the catalog API is hit, and what's slow. Built on HTTP metrics + Postgres reads — when the in-process service_health gauge lands (see TODOS.md), add a per-service Status panel.",
  "editable": true,
  "graphTooltip": 0,
  "title": "DevOps Toolkit — Service Catalog",
  "tags": ["devops-toolkit", "service-catalog"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services Total",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS n FROM services WHERE deleted_at IS NULL",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Services by Tier",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT tier, COUNT(*) AS n FROM services WHERE deleted_at IS NULL GROUP BY tier",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^n$/", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "critical" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "important" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "standard" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "On-Call (active shifts)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS n FROM on_calls WHERE shift_start <= now() AND shift_end > now()",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Runbook Entries",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS n FROM runbook_entries",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Catalog API req/s (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(devops_toolkit_http_requests_total{route=~\"/api/v1/services.*\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Catalog Error Rate (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(devops_toolkit_http_requests_total{route=~\"/api/v1/services.*\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(devops_toolkit_http_requests_total{route=~\"/api/v1/services.*\"}[5m])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Health Endpoint Hits (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(increase(devops_toolkit_http_requests_total{route=\"/api/v1/services/:id/health\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Catalog Request Rate by Route (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (route) (rate(devops_toolkit_http_requests_total{route=~\"/api/v1/services.*\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Catalog p95 Latency by Route (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(devops_toolkit_http_request_duration_seconds_bucket{route=~\"/api/v1/services.*\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          }
        }
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Services (current snapshot)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT s.name, s.tier, s.owner, COUNT(r.id) AS runbook_count, MAX(o.shift_end) AS oncall_until FROM services s LEFT JOIN runbook_entries r ON r.service_id = s.id LEFT JOIN on_calls o ON (o.service_id = s.id OR o.service_id IS NULL) AND o.shift_start <= now() AND o.shift_end > now() WHERE s.deleted_at IS NULL GROUP BY s.id, s.name, s.tier, s.owner ORDER BY CASE s.tier WHEN 'critical' THEN 1 WHEN 'important' THEN 2 ELSE 3 END, s.name",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "tier" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "critical": { "color": "red", "index": 0 }, "important": { "color": "yellow", "index": 1 }, "standard": { "color": "green", "index": 2 } } }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Currently On Call",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT COALESCE(s.name, '<global>') AS service, o.user_email AS \"on call\", o.shift_start, o.shift_end FROM on_calls o LEFT JOIN services s ON s.id = o.service_id WHERE o.shift_start <= now() AND o.shift_end > now() ORDER BY service NULLS LAST",
          "refId": "A",
          "format": "table"
        }
      ]
    }
  ]
}
