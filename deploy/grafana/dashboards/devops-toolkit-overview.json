{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Top-level DevOps Toolkit health: HTTP traffic, pipeline outcomes, host probe availability, error rate. Drill-down into the per-domain dashboards via the row links.",
  "editable": true,
  "graphTooltip": 0,
  "title": "DevOps Toolkit — Overview",
  "tags": ["devops-toolkit", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(increase(http_requests_total[5m]))", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pipeline Runs (1h, by status)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT status, COUNT(*) AS n FROM pipeline_runs WHERE started_at > now() - interval '1 hour' GROUP BY status",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Hosts Online / Total",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT SUM(CASE WHEN state='online' THEN 1 ELSE 0 END) AS online, COUNT(*) AS total FROM physical_hosts WHERE deleted_at IS NULL",
          "refId": "A",
          "format": "table"
        }
      ],
      "options": { "colorMode": "value" }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s by status code)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "p95 Latency (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Pipeline Runs (last 24h, by status)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT $__time(started_at), status, COUNT(*) FROM pipeline_runs WHERE $__timeFilter(started_at) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Host Probe Outcomes (last 1h)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "postgres", "uid": "Postgres" },
      "targets": [
        {
          "rawSql": "SELECT $__time(checked_at), result, COUNT(*) FROM physical_host_probes WHERE $__timeFilter(checked_at) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A",
          "format": "time_series"
        }
      ]
    }
  ]
}
